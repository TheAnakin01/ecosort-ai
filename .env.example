# EcoSort AI local environment variables.
# Copy this file to .env and fill in your own values.
# .env is gitignored and must never be committed.

# Roboflow Private API Key — used by ai-model/scripts/download_datasets.py.
# Get it from Roboflow → Settings → API Keys (the Private key, not the rf_ publishable key).
ROBOFLOW_API_KEY=your_roboflow_api_key_here
