# Backend settings. Copy to .env and start the server with:
#   uvicorn app.main:app --env-file .env
# Every line is optional; the values shown are the defaults.
# The server refuses to start if a value is out of range.

# ----- Model -----

# Path to the trained weights file.
# A .pt file runs on PyTorch/Ultralytics; a .onnx file runs on onnxruntime
# (no PyTorch, about a third of the memory). Export with ai-model/scripts/export_onnx.py.
# MODEL_PATH=../ai-model/weights/best.pt

# Name and version of the deployed model. Both are returned by
# /api/v1/model-info, and the version is included in every scan result.
MODEL_NAME=yolo-nano-waste-detector
MODEL_VERSION=baseline

# Detections below this confidence are not returned.
# A first guess: not yet tuned on validation data.
CONFIDENCE_THRESHOLD=0.35

# Detections below this are returned but flagged as uncertain.
# A first guess: not yet tuned on validation data.
LOW_CONFIDENCE_THRESHOLD=0.5

# How much two boxes may overlap before the weaker one is removed.
IOU_THRESHOLD=0.7

# Image size the model runs at. "auto" uses the size it was trained with,
# which is what it detects best at. Otherwise a multiple of 32, such as 640.
IMAGE_SIZE=auto

# Most items returned for one photo.
MAX_DETECTIONS=100

# "auto", "cpu" or "cuda".
DEVICE=auto

# Give up on a photo after this many seconds.
INFERENCE_TIMEOUT_SECONDS=30

# ----- Uploads -----

# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=10

# Largest accepted image side, in pixels.
MAX_IMAGE_SIDE=6000

# Largest accepted image, in megapixels (width x height).
MAX_IMAGE_MEGAPIXELS=24

# ----- Access -----

# Websites allowed to call the API from a browser, separated by commas.
# Phone apps are not affected by this.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,https://theanakin01.github.io

# ----- Abuse protection -----

# Scans allowed per client IP per minute. 0 turns the limit off.
# RATE_LIMIT_PER_MINUTE=60

# Set to true only behind a proxy that sets X-Forwarded-For (Render, a tunnel).
# Otherwise every client looks like the proxy and shares one limit.
# TRUST_PROXY_HEADERS=false
