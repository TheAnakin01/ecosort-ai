# Backend settings. Copy to .env and start the server with:
#   uvicorn app.main:app --env-file .env
# Every line is optional; the values shown are the defaults.

# Path to the trained weights file.
# MODEL_PATH=../ai-model/weights/best.pt

# A label for the deployed model, shown by /api/v1/model-info.
MODEL_VERSION=baseline

# Detections below this confidence are not returned.
# Not yet tuned on validation data.
CONFIDENCE_THRESHOLD=0.35

# Detections below this are returned but flagged as uncertain.
# Not yet tuned on validation data.
LOW_CONFIDENCE_THRESHOLD=0.5

# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=10

# Largest accepted image side, in pixels.
MAX_IMAGE_SIDE=6000
